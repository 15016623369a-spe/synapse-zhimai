# ===== Synapse · 知脉 配置 =====
# 端口（前端+API 同端口）
SYNAPSE_PORT=7800

# ===== 可选：接入任意 OpenAI 兼容大模型（DeepSeek / OpenAI / Ollama / vLLM…）=====
# 不配置也能运行：将使用内置「本地检索问答」，不联网、不需要 Key。
SYNAPSE_LLM_BASE_URL=https://api.deepseek.com/v1
SYNAPSE_LLM_API_KEY=
SYNAPSE_LLM_MODEL=deepseek-chat
SYNAPSE_LLM_TEMPERATURE=0.2

# Ollama 本地模型示例：
# SYNAPSE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SYNAPSE_LLM_MODEL=qwen2.5:7b

# 数据目录（默认 <项目根>/data）
# SYNAPSE_DATA_DIR=

# ===== 联网知识扩展（可选，无需 Key）=====
# 搜索 provider：bing（默认，cn.bing.com）/ searxng（自建）/ mock（测试）
SYNAPSE_SEARCH_PROVIDER=bing
# SYNAPSE_SEARXNG_URL=http://127.0.0.1:8080
# SYNAPSE_SEARCH_MAX_RESULTS=6
# SYNAPSE_SEARCH_TIMEOUT=20
# 是否允许抓取内网/环回地址（默认 0，测试时才开启）
# SYNAPSE_ALLOW_PRIVATE_FETCH=0

# ===== Docker Compose 可选 =====
# docker compose 会自动读取此文件做变量替换；不要提交真实 Key
# SYNAPSE_PORT=7800
